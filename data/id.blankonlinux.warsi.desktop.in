[Desktop Entry]
# Translators: Please treat "Warsi" and "Bazaar" as brand names and avoid translating.
Name=Warsi
GenericName=App Store
Comment=Add, remove or update flatpak software on this computer
Exec=warsi-daemon %U
Icon=id.blankonlinux.warsi
Terminal=false
Type=Application
Categories=GTK;Utility;
Keywords=System;Package;Manager;Discover;Flatpak;Software;App;Store;Warung Aplikasi;Bazaar;GNOME Software;
StartupNotify=true
MimeType=x-scheme-handler/appstream;x-scheme-handler/flatpak;x-scheme-handler/flatpak+https;application/vnd.flatpak;application/vnd.flatpak.ref;application/x-freedesktop-appstream-component;
Actions=new-window;
X-Purism-FormFactor=Workstation;Mobile;

[Desktop Action new-window]
Name=New Window
Exec=warsi-daemon %U
