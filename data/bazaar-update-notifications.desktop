# DOWNSTREAM PATCH (APT system updates): see ai-patches/PLAN.md
# Installed as $sysconfdir/xdg/autostart/warsi.desktop. Runs Warsi's
# background service at login, which checks for app and system updates and
# notifies about them, while the "update-notifications" setting is on.
[Desktop Entry]
Type=Application
Name=Warsi
Exec=warsi-daemon --no-window
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Condition=GSettings id.blankonlinux.warsi update-notifications
